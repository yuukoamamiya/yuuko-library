# Copy to .env.local and fill in the bucket-scoped R2 S3 credentials locally.
# Do not place the Cloudflare API token value here; the S3 client uses this pair.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: token restricted to the site's Cloudflare zone, with DNS Edit permission.
# Only needed for command-line DNS changes; Wrangler OAuth handles Pages deployments.
CLOUDFLARE_DNS_API_TOKEN=
