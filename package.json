    "verify": "tsx tools/maintenance/cli.ts verify"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "astro": "7.4.7",
    "fast-xml-parser": "5.12.0",
    "fast-xml-validator": "1.4.2",
    "html-to-text": "10.0.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/html-to-text": "9.0.4",
    "@types/node": "26.6.6",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.158.0",
    "yazl": "3.3.1"
