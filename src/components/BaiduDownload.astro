---
import type { BaiduDownload as BaiduRecord } from '../lib/books';
interface Props { record: BaiduRecord; preview?: boolean }
const { record, preview = false } = Astro.props;
---
{!preview && <>
<div class="baidu-download">
  <button class="baidu-trigger" type="button" data-baidu-open aria-haspopup="dialog" hidden>网盘下载</button>
  <dialog class="baidu-dialog" aria-labelledby="baidu-heading" data-baidu-dialog>
    <div class="baidu-dialog-content">
      <button class="baidu-close" type="button" data-baidu-close aria-label="关闭">×</button>
      <h2 id="baidu-heading">网盘下载</h2>
      {record.archive && <p class="baidu-archive-summary">RAR 压缩包 · {record.archive.filename}</p>}
      <p>提取码</p>
      <div class="baidu-field"><input readonly value={record.code} aria-label="提取码" data-baidu-code /><button type="button" data-baidu-copy="code">复制提取码</button></div>
      {record.archive && <><p>解压密码</p><div class="baidu-field"><input readonly value={record.archive.password} aria-label="解压密码" data-baidu-password /><button type="button" data-baidu-copy="password">复制解压密码</button></div></>}
      <p>分享链接</p>
      <div class="baidu-field"><input readonly value={record.url} aria-label="分享链接" data-baidu-url /><button type="button" data-baidu-copy="url">复制链接</button></div>
      <p class="baidu-status" aria-live="polite" data-baidu-status></p>
      <a class="baidu-external" href={record.url} target="_blank" rel="noopener noreferrer">打开百度网盘</a>
    </div>
  </dialog>
  <noscript><details class="baidu-fallback"><summary>网盘下载</summary>{record.archive && <><p>RAR 压缩包：<code>{record.archive.filename}</code></p><p>解压密码：<code>{record.archive.password}</code></p></>}<p>提取码：<code>{record.code}</code></p><p>分享链接：<a href={record.url} target="_blank" rel="noopener noreferrer">{record.url}</a></p></details></noscript>
</div>
</>}
<style>
  .baidu-download{margin-top:10px}.baidu-trigger{width:100%;padding:12px 16px;border:1px solid #87947d;background:transparent;color:var(--green);font:inherit;font-size:12px;cursor:pointer}.baidu-trigger:hover{background:#e8ebe2}.baidu-dialog{width:min(440px,calc(100vw - 32px));max-width:calc(100vw - 32px);padding:0;border:1px solid #d7dacc;background:#f7f6ef;color:var(--ink);box-shadow:0 15px 55px #20272244}.baidu-dialog::backdrop{background:#1f2922a8}.baidu-dialog-content{position:relative;padding:28px;min-width:0}.baidu-dialog h2{font:500 22px var(--serif);margin:0 32px 24px 0}.baidu-dialog-content>p:not(.baidu-status){font-size:11px;color:var(--muted);margin:16px 0 7px}.baidu-archive-summary{overflow-wrap:anywhere}.baidu-close{position:absolute;right:15px;top:12px;border:0;background:none;font-size:25px;color:var(--muted);cursor:pointer}.baidu-field{display:flex;gap:8px;min-width:0}.baidu-field input{min-width:0;flex:1;width:0;padding:10px;border:1px solid var(--line);background:#fff;color:var(--ink);font:12px var(--sans);user-select:text}.baidu-field button,.baidu-external{flex-shrink:0;padding:9px 12px;border:0;background:var(--green);color:#fff;font:inherit;font-size:11px;cursor:pointer}.baidu-status{min-height:1.5em;margin:12px 0 5px;font-size:11px;color:var(--muted)}.baidu-external{display:inline-block;text-decoration:none}.baidu-fallback{margin-top:10px;font-size:12px;overflow-wrap:anywhere}.baidu-fallback p{overflow-wrap:anywhere}.baidu-fallback a{color:var(--green)}
  @media(max-width:380px){.baidu-dialog-content{padding:22px 16px}.baidu-field{flex-wrap:wrap}.baidu-field input{flex-basis:100%;width:100%}}
</style>
<script>
  document.querySelectorAll<HTMLElement>('.baidu-download').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-baidu-dialog]');
    const opener = root.querySelector<HTMLButtonElement>('[data-baidu-open]');
    const closer = root.querySelector<HTMLButtonElement>('[data-baidu-close]');
    const status = root.querySelector<HTMLElement>('[data-baidu-status]');
    if (!dialog || !opener || !closer || !status) return;
    opener.addEventListener('click', () => dialog.showModal());
    closer.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => opener.focus());
    root.querySelectorAll<HTMLButtonElement>('[data-baidu-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        const fieldSelector = button.dataset.baiduCopy === 'code' ? '[data-baidu-code]'
          : button.dataset.baiduCopy === 'password' ? '[data-baidu-password]' : '[data-baidu-url]';
        const field = root.querySelector<HTMLInputElement>(fieldSelector);
        if (!field) return;
        try {
          if (!navigator.clipboard?.writeText) throw new Error('clipboard unavailable');
          await navigator.clipboard.writeText(field.value);
          status.textContent = button.dataset.baiduCopy === 'code' ? '提取码已复制。'
            : button.dataset.baiduCopy === 'password' ? '解压密码已复制。' : '分享链接已复制。';
        } catch {
          field.focus(); field.select();
          status.textContent = '无法自动复制，文本已选中，请手动复制。';
        }
      });
    });
    opener.hidden = false;
  });
</script>
