---
import '../styles/global.css';
import '../styles/identity.css';
import { SITE_TITLE, SITE_NOTICE } from '../lib/site';
interface Props { title?: string; description?: string; preview?: boolean }
const { title = SITE_TITLE, description = SITE_NOTICE, preview = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f7f3ec" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} · 新书订阅`} href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到内容</a>
    <header class="site-header">
      <a href="/" class="brand" aria-label={`${SITE_TITLE}首页`}>
        <svg width="29" height="30" viewBox="0 0 29 30" fill="none" aria-hidden="true"><path d="M3 5h9.5l2 3 2-3H26v21h-9.5l-2 2-2-2H3V5Z" stroke="currentColor" stroke-width="1.7"/><path d="M14.5 8v20M7 10h4M7 14h4M18 10h4M18 14h4" stroke="currentColor" stroke-width="1.4"/></svg>
        <span>{SITE_TITLE}<span class="brand-en">AMAMIYA YUUKO LIBRARY</span></span>
      </a>
      <nav aria-label="主导航"><a href="/" class="nav-library">全部书籍</a><a href="/#about">关于书架 <span aria-hidden="true">↗</span></a></nav>
      {preview && <div class="header-note"><span class="status-dot"></span>本地预览 · 尚未发布</div>}
    </header>
    <slot />
    <footer class="site-footer" id="about">
      <a class="footer-brand" href="/">{SITE_TITLE}</a>
      <p>AI 译本可能存在翻译偏差，请参照原文。 <a href="/rss.xml">RSS 订阅</a></p>
    </footer>
  </body>
</html>
