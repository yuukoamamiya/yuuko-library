---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import { loadBooks, subjectsOf } from '../lib/books';
import { SITE_TITLE, SITE_NOTICE } from '../lib/site';
import { CATEGORIES } from '../lib/categories';
const books = await loadBooks();
const counts = new Map<string, number>();
books.forEach(book => subjectsOf(book).forEach(subject => counts.set(subject, (counts.get(subject) ?? 0) + 1)));
const categoryCounts = new Map(CATEGORIES.map(category => [category.id, books.filter(book => book.categories.includes(category.id)).length]));
const subjects = [...counts.keys()].sort((a, b) => a.localeCompare(b, 'zh-CN'));
const models = new Set(books.filter(book => book.edition.kind === 'ai-translation').map(book => book.edition.model));
const preview = await readFile(path.resolve(process.env.BOOK_SITE_ROOT ?? process.cwd(), 'catalog/preview.json'), 'utf8').then(() => true).catch(() => false);
---
<Layout preview={preview}>
  <main id="main">
    <section class="hero">
      <div class="hero-copy">
        <h1>{SITE_TITLE}</h1>
        <p class="hero-description">{SITE_NOTICE}</p>
        <a class="hero-link" href="#library">浏览馆藏 <span aria-hidden="true">↘</span></a>
      </div>
      <div class="hero-aside" aria-label="书架统计">
        <p class="aside-label">馆藏概览 <span>COLLECTION</span></p>
        <div class="hero-stats"><div><strong>{books.length.toString().padStart(2, '0')}</strong><span>本电子书</span></div><div><strong>{models.size.toString().padStart(2, '0')}</strong><span>种翻译模型</span></div></div>
        <span class="aside-caption">AI 翻译 · 中文出版物转录 · EPUB</span>
      </div>
    </section>
    <section class="library-section" id="library" aria-labelledby="library-heading">
      <div class="library-heading"><div><span class="section-index">01 / COLLECTION</span><h2 id="library-heading">全部书籍<span class="count-badge">{books.length}</span></h2></div></div>
      <div class="library-layout">
        <aside class="filters" aria-label="书籍分类">
          <span class="filter-caption">浏览分类 <span aria-hidden="true">⌘</span></span>
          <div class="category-list">
            <button type="button" class="category-button active" data-category="" aria-pressed="true"><span>全部书籍</span><span>{books.length}</span></button>
            {CATEGORIES.map(category => <button type="button" class="category-button" data-category={category.id} aria-pressed="false"><span>{category.label}</span><span>{categoryCounts.get(category.id)}</span></button>)}
          </div>
          <label class="all-categories" for="category-select">分类</label>
          <select id="category-select" aria-label="选择分类"><option value="">全部分类</option>{CATEGORIES.map(category => <option value={category.id}>{category.label} ({categoryCounts.get(category.id)})</option>)}</select>
          <label class="tag-label" for="tag-filter">标签 · {subjects.length}</label>
          <input type="search" id="tag-filter" list="tag-options" placeholder="搜索或选择标签" autocomplete="off" />
          <datalist id="tag-options">{subjects.map(subject => <option value={subject}>{subject} ({counts.get(subject)})</option>)}</datalist>
        </aside>
        <div class="books-area">
          <form class="search-toolbar" role="search" action="/" method="get">
            <div class="search-field"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><label for="book-search" class="sr-only">搜索书名、作者、简介或标签</label><input id="book-search" name="q" type="search" placeholder="搜索书名、作者、简介…" autocomplete="off" /><kbd aria-hidden="true">/</kbd></div>
            <label class="sort-control">排序<select id="sort-order" aria-label="书籍排序"><option value="default">最近更新</option><option value="uploaded">最新上传</option><option value="title">书名 A—Z</option><option value="author">作者 A—Z</option></select></label>
          </form>
          <div class="results-bar"><p id="result-count" role="status" aria-live="polite">共 {books.length} 本书籍</p><button id="reset-filters" type="button" hidden>清除筛选 <span aria-hidden="true">×</span></button><span class="format-label">EPUB COLLECTION</span></div>
          <div class="book-grid" id="book-grid">{books.map((book, index) => <BookCard book={book} index={index} />)}</div>
          <div class="empty-state" id="empty-state" hidden><span aria-hidden="true">⌕</span><h3>暂时没有找到这本书</h3><p>试试其他关键词，或清除筛选。</p><button type="button" id="empty-reset">查看全部书籍 <span aria-hidden="true">↗</span></button></div>
          {books.length === 0 && <div class="empty-state"><h3>书架正待填满</h3><p>准备 EPUB 后，即可在本地预览书籍。</p></div>}
          <noscript><p class="no-script">全部书籍已列出。启用 JavaScript 后可使用本地搜索、分类与标签筛选。</p></noscript>
        </div>
      </div>
    </section>
  </main>
</Layout>
<script>
  import { compareByUploadDate, matches, type SearchEntry } from '../lib/search';
  import { categoryLabel } from '../lib/categories';
  async function init() {
    const search = document.querySelector<HTMLInputElement>('#book-search')!;
    const select = document.querySelector<HTMLSelectElement>('#category-select')!;
    const tag = document.querySelector<HTMLInputElement>('#tag-filter')!;
    const sort = document.querySelector<HTMLSelectElement>('#sort-order')!;
    const form = document.querySelector<HTMLFormElement>('.search-toolbar')!;
    const grid = document.querySelector<HTMLElement>('#book-grid')!;
    const cards = new Map([...grid.querySelectorAll<HTMLElement>('[data-book-id]')].map(card => [card.dataset.bookId!, card]));
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-category]');
    const count = document.querySelector<HTMLElement>('#result-count')!;
    const reset = document.querySelector<HTMLButtonElement>('#reset-filters')!;
    let entries: SearchEntry[];
    fromUrl(true);
    try {
      const response = await fetch('/search-index.json');
      if (!response.ok) throw new Error('索引加载失败');
      entries = await response.json();
    } catch { count.textContent = '搜索暂不可用，仍可浏览全部书籍。'; return; }
    function fromUrl(preserveTypedInput = false) {
      const params = new URLSearchParams(location.search);
      search.value = params.get('q') ?? (preserveTypedInput ? search.value : '');
      select.value = params.get('category') ?? '';
      tag.value = params.get('subject') ?? '';
      sort.value = ['uploaded', 'title', 'author'].includes(params.get('sort') ?? '') ? params.get('sort')! : 'default';
    }
    function render(updateUrl = true) {
      const query = search.value; const subject = tag.value.trim(); const category = select.value;
      const ordered = [...entries];
      if (sort.value === 'uploaded') ordered.sort(compareByUploadDate);
      else if (sort.value === 'title' || sort.value === 'author') ordered.sort((a, b) => (sort.value === 'title' ? a.title : a.authors.join(' ')).localeCompare(sort.value === 'title' ? b.title : b.authors.join(' '), 'zh-CN'));
      let total = 0;
      ordered.forEach(entry => {
        const card = cards.get(entry.id); if (!card) return;
        const visible = matches(entry, query, subject, category);
        card.hidden = !visible; if (visible) total++;
        grid.append(card);
      });
      count.textContent = query.trim() || subject || category ? `找到 ${total} 本书籍${category ? ` · ${categoryLabel(category)}` : ''}${subject ? ` · ${subject}` : ''}` : `共 ${total} 本书籍`;
      document.querySelector<HTMLElement>('#empty-state')!.hidden = total !== 0 || entries.length === 0;
      reset.hidden = !query && !subject && !category && sort.value === 'default';
      buttons.forEach(button => { const active = button.dataset.category === category;
        button.classList.toggle('active', active); button.setAttribute('aria-pressed', String(active)); });
      if (updateUrl) {
        const url = new URL(location.href);
        for (const [key, value] of [['q', query], ['subject', subject], ['category', category], ['sort', sort.value === 'default' ? '' : sort.value]]) {
          if (value) url.searchParams.set(key, value); else url.searchParams.delete(key);
        }
        history.replaceState(null, '', url);
      }
    }
    function clear() { search.value = ''; select.value = ''; tag.value = ''; sort.value = 'default'; render(); }
    search.addEventListener('input', () => render());
    tag.addEventListener('input', () => render());
    select.addEventListener('change', () => render()); sort.addEventListener('change', () => render());
    form.addEventListener('submit', event => { event.preventDefault(); render(); });
    buttons.forEach(button => button.addEventListener('click', () => { select.value = button.dataset.category!; render(); }));
    reset.addEventListener('click', clear); document.querySelector('#empty-reset')!.addEventListener('click', clear);
    window.addEventListener('popstate', () => { fromUrl(); render(false); });
    document.addEventListener('keydown', event => {
      if (event.key === '/' && !event.ctrlKey && !event.metaKey && !event.altKey && !['INPUT', 'TEXTAREA', 'SELECT'].includes((event.target as HTMLElement).tagName)) {
        event.preventDefault(); search.focus();
      }
    });
    render(false);
  }
  init();
</script>
